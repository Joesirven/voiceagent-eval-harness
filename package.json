{
  "name": "voiceagent-eval-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server/dev-server.ts",
    "check": "pnpm build:web && pnpm typecheck && vitest run",
    "test": "pnpm build:web && vitest run",
    "typecheck": "tsc --noEmit && tsc -p web --noEmit && tsc -p lab/tsconfig.json --noEmit && tsc -p designs/tsconfig.json --noEmit",
    "records:purge": "tsx scripts/purge-records.ts",
    "tree:validate": "tsx scripts/validate-decision-tree.ts",
    "tree:assemble": "tsx scripts/assemble-decision-tree.ts",
    "tree:flow": "tsx scripts/compile-tree-flow.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "build:designs": "vite build --config designs/vite.config.ts",
    "dev:designs": "vite --config designs/vite.config.ts"
  },
  "dependencies": {
    "@pipecat-ai/client-js": "^1.14.0",
    "@pipecat-ai/client-react": "^1.9.0",
    "@pipecat-ai/small-webrtc-transport": "^1.11.0",
    "@radix-ui/react-use-controllable-state": "^1.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "motion": "^13.2.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "use-stick-to-bottom": "^1.1.6",
    "ws": "^8.22.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.4",
    "vitest": "^2.1.0"
  }
}
